APP_NAME=task-planner-service

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_GPT52_DEPLOYMENT=your-gpt52-thinking-deployment
AZURE_OPENAI_VISION_DEPLOYMENT=your-vision-deployment

# Azure Key Vault + Redis
AZURE_KEY_VAULT_URL=https://your-key-vault.vault.azure.net/
AZURE_REDIS_PASSWORD_SECRET_NAME=redis-password-secret
AZURE_REDIS_HOST=your-redis-name.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_SSL=true

# Optional: direct Redis URL (overrides Key Vault config)
# REDIS_URL=redis://localhost:6379/0

# Azure SQL
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=your-user
AZURE_SQL_PASSWORD=your-password
AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Optional: direct SQLAlchemy URL (overrides Azure SQL config)
# SQL_DATABASE_URL=sqlite+aiosqlite:///./planner.db
REDIS_FILE_CACHE_ENABLED=true
REDIS_FILE_CACHE_TTL_SECONDS=3600
REDIS_FILE_CACHE_MAX_CHARS=12000
REDIS_PASSWORD_CACHE_TTL_SECONDS=300

# Planning + Extraction Limits
MAX_FILE_CONTEXT_CHARS=6000
MAX_FILE_ROWS=200
MAX_OCR_PAGES=10
MIN_PDF_TEXT_CHARS=50
# Preferred token limit for GPT-5.2 planning
PLANNING_MAX_OUTPUT_TOKENS=2500
# Legacy alias (optional)
# PLANNING_MAX_TOKENS=2500
# Optional: omit for GPT-5.2 thinking models that don't support temperature
PLANNING_TEMPERATURE=
