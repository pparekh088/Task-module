APP_NAME=task-planner-service

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_GPT52_DEPLOYMENT=your-gpt52-thinking-deployment
AZURE_OPENAI_VISION_DEPLOYMENT=your-vision-deployment

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=your-blob-connection-string
AZURE_BLOB_CONTAINER=your-container
AZURE_BLOB_SAS_TOKEN=
AZURE_BLOB_ACCOUNT_KEY=

# Persistence
SQL_DATABASE_URL=sqlite+aiosqlite:///./planner.db
REDIS_URL=redis://localhost:6379/0

# Planning + Extraction Limits
MAX_FILE_CONTEXT_CHARS=6000
MAX_FILE_ROWS=200
MAX_OCR_PAGES=10
MIN_PDF_TEXT_CHARS=50
# Preferred token limit for GPT-5.2 planning
PLANNING_MAX_OUTPUT_TOKENS=2500
# Legacy alias (optional)
# PLANNING_MAX_TOKENS=2500
# Optional: omit for GPT-5.2 thinking models that don't support temperature
PLANNING_TEMPERATURE=
